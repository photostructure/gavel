{
  "name": "difit-vscode",
  "displayName": "difit",
  "version": "0.1.0",
  "description": "GitHub-like diff review inside VS Code. difit is bundled — no extra install needed.",
  "categories": [
    "Other"
  ],
  "homepage": "https://github.com/yoshiko-pg/difit",
  "bugs": {
    "url": "https://github.com/yoshiko-pg/difit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoshiko-pg/difit.git"
  },
  "publisher": "yoshiko-pg",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "package": "pnpm --dir ../.. run build && node build.mjs && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@parcel/watcher": "^2.6.0",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.102.0",
    "@vscode/vsce": "^4.0.0",
    "detect-libc": "^2.1.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "difit.openReview",
        "title": "difit: Open Review",
        "icon": {
          "light": "assets/favicon.svg",
          "dark": "assets/favicon-white.svg"
        }
      },
      {
        "command": "difit.stopReview",
        "title": "difit: Stop Review"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "difit.openReview",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "difit",
      "properties": {
        "difit.executablePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to an external difit executable. Leave empty to use the difit version bundled with this extension."
        },
        "difit.editor": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "vscode",
            "cursor",
            "zed",
            "textmate",
            "bbedit",
            "emacs",
            "macvim",
            "sublime",
            "nova",
            "none"
          ],
          "description": "Editor preset for Open in editor. Auto preserves inherited DIFIT_EDITOR; otherwise it selects Cursor in Cursor, or uses a recognized EDITOR preset in VS Code, falling back to VS Code. A selected preset overrides inherited DIFIT_EDITOR. Restart the review after changing this setting."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "assets/logo.png",
  "engines": {
    "vscode": "^1.102.0"
  }
}
