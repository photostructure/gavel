{
  "name": "@photostructure/gavel",
  "version": "5.1.0",
  "description": "Local Git diff viewer where you review an agent's changes, discuss them with the agent, and record a verdict",
  "keywords": [
    "cli",
    "code-review",
    "diff",
    "diff-viewer",
    "git",
    "github",
    "react",
    "review",
    "tailwind"
  ],
  "homepage": "https://github.com/photostructure/gavel",
  "bugs": {
    "url": "https://github.com/photostructure/gavel/issues"
  },
  "license": "MIT",
  "author": "yoshiko-pg",
  "repository": {
    "type": "git",
    "url": "https://github.com/photostructure/gavel.git"
  },
  "bin": {
    "gavel": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/agent-conversations.md",
    "docs/server-addresses.md",
    "docs/waiting-for-review.md",
    "docs/codex-review-integration.md",
    "docs/approval-modes.md",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.map"
  ],
  "type": "module",
  "main": "./dist/cli/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:cli": "tsc --project tsconfig.cli.json && NODE_ENV=development node dist/cli/index.js",
    "build": "pnpm run build:cli && vite build",
    "build:cli": "tsc --project tsconfig.cli.json",
    "start": "pnpm run build && node dist/cli/index.js",
    "check": "oxlint . --type-aware --type-check --deny-warnings --report-unused-disable-directives",
    "check:fix": "oxlint . --type-aware --type-check --deny-warnings --report-unused-disable-directives --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "knip": "knip --use-tsconfig-files",
    "test": "vitest run",
    "test:watch": "vitest",
    "update": "pnpm run update:deps && pnpm run update:pinact",
    "update:deps": "pnpm update --latest --recursive",
    "install:pinact": "go install github.com/suzuki-shunsuke/pinact/v4/cmd/pinact@v4.1.0",
    "update:pinact": "pinact run -u",
    "preflight": "pnpm run update && pnpm run format:fix && pnpm run check:fix && pnpm run knip && pnpm run build && pnpm test",
    "perf": "node scripts/measure-performance.js",
    "perf:small": "node scripts/measure-performance.js --size small",
    "perf:medium": "node scripts/measure-performance.js --size medium",
    "perf:large": "node scripts/measure-performance.js --size large",
    "perf:xlarge": "node scripts/measure-performance.js --size xlarge",
    "perf:compare": "node scripts/compare-performance.js"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@parcel/watcher": "^2.6.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "express": "^5.3.0",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.61.0",
    "open": "^11.0.4",
    "prism-react-renderer": "^2.4.1",
    "prism-svelte": "^0.5.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tsconfig/strictest": "^2.0.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "knip": "^6.43.0",
    "mermaid": "^12.2.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "undici": "^8.12.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.6.0"
}
